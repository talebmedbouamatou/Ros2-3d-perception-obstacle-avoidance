<?xml version="1.0"?>

<robot name="robot">

  <!-- ====================================================== -->
  <!--                       BASE LINK                        -->
  <!-- ====================================================== -->

  <link name="base_link">

    <inertial>
      <origin
        xyz="0.0121459734710621 0.000198241570210142 0.0449906840595474"
        rpy="0 0 0"/>

      <mass value="1.00796524149794"/>

      <inertia
        ixx="0.000664022840014205"
        ixy="3.36477372709559E-06"
        ixz="-6.46022439037541E-06"
        iyy="0.00190520705036307"
        iyz="5.00471440887707E-10"
        izz="0.00244406959005576"/>
    </inertial>

    <!-- Modèle visuel simplifié pour Gazebo -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="file:///home/taleb/projet_be/src/robot_description/meshes/base_link_gazebo.STL"/>
      </geometry>

      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <!-- Collision simplifiée -->
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>

      <geometry>
        <box size="0.16 0.12 0.05"/>
      </geometry>
    </collision>

  </link>


  <!-- ====================================================== -->
  <!--                   ROUE ARRIERE GAUCHE                  -->
  <!-- ====================================================== -->

  <link name="left_rear_wheel">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.0310322138231813"/>

      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>

      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>

  </link>


  <joint name="leftrearwheel" type="continuous">

    <origin
      xyz="0.0588 -0.07355 0.011"
      rpy="-1.5708 0 -3.1416"/>

    <parent link="base_link"/>
    <child link="left_rear_wheel"/>

    <axis xyz="0 0 -1"/>

    <limit effort="100" velocity="100"/>

    <dynamics damping="0.1" friction="0.1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                   ROUE ARRIERE DROITE                  -->
  <!-- ====================================================== -->

  <link name="right_rear_wheel">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.0310322138231813"/>

      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>

      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>

  </link>


  <joint name="rightrearwheel" type="continuous">

    <origin
      xyz="0.058826 0.07355 0.011"
      rpy="-1.5708 0 -3.1416"/>

    <parent link="base_link"/>
    <child link="right_rear_wheel"/>

    <axis xyz="0 0 -1"/>

    <limit effort="100" velocity="100"/>

    <dynamics damping="0.1" friction="0.1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                    ROUE AVANT GAUCHE                   -->
  <!-- ====================================================== -->

  <link name="left_front_wheel">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.0310322138231813"/>

      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>

      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>

  </link>


  <joint name="left_front_wheel_joint" type="continuous">

    <origin
      xyz="-0.058826 -0.07355 0.011"
      rpy="-1.5708 0 -3.1416"/>

    <parent link="base_link"/>
    <child link="left_front_wheel"/>

    <axis xyz="0 0 -1"/>

    <limit effort="100" velocity="100"/>

    <dynamics damping="0.1" friction="0.1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                    ROUE AVANT DROITE                   -->
  <!-- ====================================================== -->

  <link name="right_front_wheel">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.0310322138231806"/>

      <inertia
        ixx="1.37618924502919E-05"
        ixy="0"
        ixz="0"
        iyy="1.3762060037714E-05"
        iyz="0"
        izz="2.28600342994278E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>

      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>

  </link>


  <joint name="rightfrontwheel" type="continuous">

    <origin
      xyz="-0.0588 0.07355 0.011"
      rpy="-1.5708 0 -3.1416"/>

    <parent link="base_link"/>
    <child link="right_front_wheel"/>

    <axis xyz="0 0 -1"/>

    <limit effort="100" velocity="100"/>

    <dynamics damping="0.1" friction="0.1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                         LIDAR                          -->
  <!-- ====================================================== -->

  <link name="lidar_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.125"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>

      <material name="lidar_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
    </collision>

  </link>


  <joint name="lidar_joint" type="fixed">

    <origin xyz="-0.068 0 0.12" rpy="0 0 0"/>

    <parent link="base_link"/>
    <child link="lidar_link"/>

  </joint>


  <!-- ====================================================== -->
  <!--                       CAMERA LINK                      -->
  <!-- ====================================================== -->

  <link name="camera_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.08"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.01 0.01 0.03"/>
      </geometry>

      <material name="camera_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.001 0.001 0.03"/>
      </geometry>
    </collision>

  </link>


  <joint name="camera_joint" type="fixed">

    <origin
      xyz="-0.078 0 0.09"
      rpy="0 0 3.15"/>

    <parent link="base_link"/>
    <child link="camera_link"/>

  </joint>


  <!-- ====================================================== -->
  <!--                CAMERA OPTICAL FRAME                    -->
  <!-- ====================================================== -->

  <link name="camera_optical_link"/>


  <joint name="camera_optical_joint" type="fixed">

    <origin
      xyz="0 0 0"
      rpy="-1.5707963267948966 0 -1.5707963267948966"/>

    <parent link="camera_link"/>
    <child link="camera_optical_link"/>

  </joint>


  <!-- ====================================================== -->
  <!--             CONTROLEUR DIFFERENTIEL GAZEBO             -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      name="diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <!-- Deux paires de roues -->
      <num_wheel_pairs>2</num_wheel_pairs>

      <!-- Paire avant -->
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>rightfrontwheel</right_joint>

      <!-- Paire arrière -->
      <left_joint>leftrearwheel</left_joint>
      <right_joint>rightrearwheel</right_joint>

      <!-- Géométrie du robot -->
      <wheel_separation>0.1471</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <!-- Limites -->
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>

      <!-- Topics ROS 2 -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

      <!-- Repères -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <!-- Publication de l'odométrie -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

    </plugin>

  </gazebo>


  <!-- ====================================================== -->
  <!--              CAMERA DE PROFONDEUR GAZEBO               -->
  <!-- ====================================================== -->

  <gazebo reference="camera_link">

    <sensor
      name="depth_camera"
      type="depth">

      <always_on>true</always_on>

      <update_rate>10.0</update_rate>

      <visualize>true</visualize>

      <camera>

        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.10</near>
          <far>4.0</far>
        </clip>

      </camera>


      <plugin
        name="depth_camera_controller"
        filename="libgazebo_ros_camera.so">

        <ros>
          <namespace>/depth_camera</namespace>
        </ros>

        <camera_name>depth_camera</camera_name>

        <frame_name>camera_optical_link</frame_name>

        <min_depth>0.10</min_depth>
        <max_depth>4.0</max_depth>

      </plugin>

    </sensor>

  </gazebo>


</robot>
