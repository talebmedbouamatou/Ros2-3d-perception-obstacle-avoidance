<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="couloir">

    <!-- ======================= -->
    <!--         SOLEIL          -->
    <!-- ======================= -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ======================= -->
    <!--          SOL            -->
    <!-- ======================= -->

    <include>
      <uri>model://ground_plane</uri>
    </include>


    <!-- ======================= -->
    <!--      MUR GAUCHE         -->
    <!-- ======================= -->

    <model name="mur_gauche">
      <static>true</static>

      <pose>-2.5 -1.0 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>7 0.10 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 0.10 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!--       MUR DROIT         -->
    <!-- ======================= -->

    <model name="mur_droit">
      <static>true</static>

      <pose>-2.5 1.0 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>7 0.10 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 0.10 0.5</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!--       OBSTACLE 1        -->
    <!-- ======================= -->

    <model name="obstacle_1">
      <static>true</static>

      <pose>-1.5 0.35 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.35 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.35 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!--       OBSTACLE 2        -->
    <!-- ======================= -->

    <model name="obstacle_2">
      <static>true</static>

      <pose>-3.0 -0.35 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.35 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.35 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!--       OBSTACLE 3        -->
    <!-- ======================= -->

    <model name="obstacle_3">
      <static>true</static>

      <pose>-4.5 0.25 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.65 0.50</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.65 0.50</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


  </world>

</sdf>
